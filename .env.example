# Backend
APP_NAME=VedaAI Assessment Extractor API
APP_ENV=development
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:3000

# Required from Phase 2 onwards (Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Required from Phase 4 onwards (Supabase project settings)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Required only to apply SQL migrations. Obtain the URI from Supabase Connect.
SUPABASE_DB_URL=
SUPABASE_QUESTION_PAPERS_BUCKET=question-papers
SUPABASE_ANSWER_SHEETS_BUCKET=answer-sheets

# --- Deployed environments only -------------------------------------------------------
# Leave both blank locally: writes stay open and nothing is throttled.
#
# DEMO_ACCESS_KEY gates the endpoints that spend Gemini quota or delete data
# (POST /parse, POST /parse/jobs, DELETE /assessments/{id}). Reads stay public so the demo
# can be explored without a signup wall. Share the deployed app as
#   https://<your-app>/?key=<DEMO_ACCESS_KEY>
# and the key is stored in that visitor's browser; it is never built into the bundle.
DEMO_ACCESS_KEY=
# Parses per client IP per hour. 0 disables. Protects the free tier even if the key leaks.
PARSE_RATE_LIMIT_PER_HOUR=0

# Frontend, used from Phase 3 onwards. This value is safe for browser exposure.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
