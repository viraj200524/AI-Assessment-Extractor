# Backend Configuration
APP_NAME=VedaAI Assessment Extractor API
APP_ENV=development
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:3000

# Google Gemini AI (Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Supabase Configuration
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# PostgreSQL connection URI (from Supabase Dashboard -> Connect) used for running migrations
SUPABASE_DB_URL=
SUPABASE_QUESTION_PAPERS_BUCKET=question-papers
SUPABASE_ANSWER_SHEETS_BUCKET=answer-sheets

# Access Control & Rate Limiting (Optional)
# Leave blank for local development to allow open writes without authentication.
# When set in production, mutating endpoints require the 'X-Demo-Key' header.
DEMO_ACCESS_KEY=
# Parses per client IP per hour (0 disables rate limiting)
PARSE_RATE_LIMIT_PER_HOUR=0

# Frontend API URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

